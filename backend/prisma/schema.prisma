generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String         @id @default(uuid())
  email                        String         @unique
  password                     String
  role                         Role           @default(STUDENT)
  name                         String
  phone                        String?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  isFirstLogin                 Boolean        @default(true)
  username                     String?        @unique
  otp                          String?
  otpExpires                   DateTime?
  profileImageUrl              String?
  profileImagePublicId         String?
  whatsapp                     String?
  emailNotificationsEnabled    Boolean        @default(true)
  whatsappNotificationsEnabled Boolean        @default(true)
  auditLogs                    AuditLog[]
  interviewer                  Interviewer?
  adminRetries                 Notification[] @relation("AdminRetries")
  notifications                Notification[] @relation("UserNotifications")
  student                      Student?
}

model Student {
  id               String            @id @default(uuid())
  userId           String?           @unique
  applicationNo    String            @unique
  dob              DateTime
  address          String?
  hifzCenter       String
  fatherName       String
  motherName       String
  status           ApplicationStatus @default(PENDING)
  documents        Json?
  dawrasCount      String?
  district         String?
  firstOption      String?
  kitabsStudied    String?
  place            String?
  resources        Json?
  schoolEducation  String?
  secondOption     String?
  thirdOption      String?
  whatsapp         String?
  name             String
  documentUrl      String?
  documentPublicId String?
  primeHifzMentor  String?
  madrasaEducation String?
  country          String?           @default("India")
  pincode          String?
  state            String?
  application      Application?
  user             User?             @relation(fields: [userId], references: [id])
}

model Application {
  id        String            @id @default(uuid())
  studentId String            @unique
  appliedAt DateTime          @default(now())
  status    ApplicationStatus @default(PENDING)
  allotment Allotment?
  student   Student           @relation(fields: [studentId], references: [id])
  interview Interview?
}

model Allotment {
  id            String      @id @default(uuid())
  applicationId String      @unique
  course        String
  campus        String
  allottedAt    DateTime    @default(now())
  isFinalized   Boolean     @default(false)
  application   Application @relation(fields: [applicationId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [actorId], references: [id])
}

model Interviewer {
  id         String      @id @default(uuid())
  userId     String      @unique
  speciality String?
  interviews Interview[]
  user       User        @relation(fields: [userId], references: [id])
}

model Interview {
  id            String       @id @default(uuid())
  applicationId String       @unique
  interviewerId String
  scheduledAt   DateTime
  location      String?      @default("Darussalam Tharqiyathul Huffaz")
  evaluations   Evaluation[]
  application   Application  @relation(fields: [applicationId], references: [id])
  interviewer   Interviewer  @relation(fields: [interviewerId], references: [id])
}

model Evaluation {
  id          String    @id @default(uuid())
  interviewId String
  subject     String
  marks       Int
  remarks     String?
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id])
}

model Result {
  id           String   @id @default(uuid())
  studentId    String   @unique
  totalMarks   Int
  averageMarks Float
  decision     String   @default("PENDING")
  generatedAt  DateTime @default(now())
  pdfUrl       String?
}

model Notification {
  id          String   @id @default(uuid())
  userId      String?
  type        String
  event       String
  message     String
  sentAt      DateTime @default(now())
  status      String   @default("SENT")
  error       String?
  data        Json?
  adminId     String?
  senderEmail String?
  triggeredBy String   @default("SYSTEM")
  isRead      Boolean  @default(false)
  admin       User?    @relation("AdminRetries", fields: [adminId], references: [id])
  user        User?    @relation("UserNotifications", fields: [userId], references: [id])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
}

model Faculty {
  id            String   @id @default(uuid())
  name          String
  photoUrl      String?
  photoPublicId String?
  position      String
  category      String
  department    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Int      @default(0)
}

model Alumni {
  id            String   @id @default(uuid())
  name          String
  photoUrl      String?
  photoPublicId String?
  place         String
  status        String
  institution   String?
  university    String?
  position      String?
  organization  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Int      @default(0)
}

model Campus {
  id        String   @id @default(uuid())
  name      String   @unique
  maxSeats  Int      @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INTERVIEWER
  STUDENT
  PRINCIPAL
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  INTERVIEW_SCHEDULED
  EVALUATED
  ACCEPTED
  REJECTED
  DOCS_VERIFIED
  ALLOTMENT_READY
  ALLOTTED
  ADMISSION_AUTHORIZED
}
