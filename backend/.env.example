# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production
JWT_SECRET=your_strong_jwt_secret

# --- DATABASE CONNECTION (RAILWAY) ---
# Use the DATABASE_URL provided in the Railway dashboard
DATABASE_URL="postgresql://user:pass@host:port/dbname"

# --- BREVO SMTP CONFIGURATION ---
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_brevo_smtp_key_here"

# --- DEPARTMENTAL EMAILS (Verified Domain) ---
EMAIL_ADMIN="admin@darussalameduvillage.com"
EMAIL_ADMISSIONS="admissions@darussalameduvillage.com"
EMAIL_SUPPORT="support@darussalameduvillage.com"
EMAIL_INFO="info@darussalameduvillage.com"
EMAIL_PRINCIPAL="principal@darussalameduvillage.com"

# --- WHATSAPP INTEGRATION (Green API) ---
WHATSAPP_API_URL="https://api.green-api.com"
WHATSAPP_ID_INSTANCE="1101xxxxxx"
WHATSAPP_API_TOKEN="token_here"

# --- FILE UPLOADS (Cloudinary) ---
# You can use the full CLOUDINARY_URL or individual keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://key:secret@cloud_name"
